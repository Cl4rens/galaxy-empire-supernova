+/// Shrink the text of the text field at `target` until it fits its width, down to
+/// `min_scale` of `base_size` (gameswf's `SetLineMax(target, true, min_scale)`). Does nothing
+/// while the text is still `last_text`. Returns the base font size and the text it fitted.
+pub fn fit_avm1_text(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    min_scale: f64,
+    base_size: Option<f64>,
+    last_text: Option<&str>,
+) -> Option<(f64, String)> {
+    with_avm1_object(context, target, |activation, object| {
+        fit_text(activation, object, min_scale, base_size, last_text).ok().flatten()
+    })
+    .flatten()
+}
+
+fn fit_text<'gc>(
+    activation: &mut Avm1Activation<'_, 'gc>,
+    object: Avm1Object<'gc>,
+    min_scale: f64,
+    base_size: Option<f64>,
+    last_text: Option<&str>,
+) -> Result<Option<(f64, String)>, Avm1Error<'gc>> {
+    let text = object.get(AvmString::new_utf8(activation.gc(), "text"), activation)?;
+    let text = text.coerce_to_string(activation)?.to_string();
+    if last_text == Some(text.as_str()) {
+        return Ok(None);
+    }
+    let get_format = AvmString::new_utf8(activation.gc(), "getTextFormat");
+    let set_format = AvmString::new_utf8(activation.gc(), "setTextFormat");
+    let size_name = AvmString::new_utf8(activation.gc(), "size");
+    let reason = crate::avm1::ExecutionReason::Special;
+    let format = object.call_method(get_format, &[], activation, reason)?;
+    let Avm1Value::Object(format) = format else {
+        return Ok(None);
+    };
+    let base = match base_size {
+        Some(size) => size,
+        None => format.get(size_name, activation)?.coerce_to_f64(activation)?,
+    };
+    // measured and shown on one line, not wrapped
+    if let Some(field) = object.as_display_object().and_then(|o| o.as_edit_text()) {
+        field.set_gameswf_single_line(activation.context);
+    }
+    if !base.is_finite() || base <= 0.0 {
+        return Ok(None);
+    }
+    format.set(size_name, base, activation)?;
+    object.call_method(set_format, &[format.into()], activation, reason)?;
+    let width = object.get(AvmString::new_utf8(activation.gc(), "_width"), activation)?.coerce_to_f64(activation)?;
+    let text_width = object.get(AvmString::new_utf8(activation.gc(), "textWidth"), activation)?.coerce_to_f64(activation)?;
+    let room = width - 4.0;
+    if text_width > room && text_width > 0.0 {
+        let size = (base * (room / text_width).max(min_scale)).floor();
+        format.set(size_name, size, activation)?;
+        object.call_method(set_format, &[format.into()], activation, reason)?;
+    }
+    Ok(Some((base, text)))
+}
+
+/// Cut the text of the text field at `target` where it leaves the field and end it with "...",
+/// as gameswf did with fields named single-line (`SLHM`: at the width, on one line) or
+/// multi-line (`MLHM`: at the height). Does nothing while the text is still `last_text`.
+/// Returns the text the field shows.
+pub fn truncate_avm1_text(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    multi_line: bool,
+    last_text: Option<&str>,
+) -> Option<String> {
+    with_avm1_object(context, target, |activation, object| {
+        truncate_text(activation, object, multi_line, last_text).ok().flatten()
+    })
+    .flatten()
+}
+
+fn truncate_text<'gc>(
+    activation: &mut Avm1Activation<'_, 'gc>,
+    object: Avm1Object<'gc>,
+    multi_line: bool,
+    last_text: Option<&str>,
+) -> Result<Option<String>, Avm1Error<'gc>> {
+    let text_name = AvmString::new_utf8(activation.gc(), "text");
+    let text = object.get(text_name, activation)?.coerce_to_string(activation)?.to_string();
+    if last_text == Some(text.as_str()) {
+        return Ok(None);
+    }
+    let Some(field) = object.as_display_object().and_then(|o| o.as_edit_text()) else {
+        return Ok(None);
+    };
+    if !multi_line {
+        field.set_gameswf_single_line(activation.context);
+    }
+    let (room_name, used_name) = if multi_line { ("_height", "textHeight") } else { ("_width", "textWidth") };
+    let room = object.get(AvmString::new_utf8(activation.gc(), room_name), activation)?.coerce_to_f64(activation)? - 4.0;
+    let used_name = AvmString::new_utf8(activation.gc(), used_name);
+    let fits = |activation: &mut Avm1Activation<'_, 'gc>, shown: &str| -> Result<bool, Avm1Error<'gc>> {
+        object.set(text_name, AvmString::new_utf8(activation.gc(), shown), activation)?;
+        Ok(object.get(used_name, activation)?.coerce_to_f64(activation)? <= room)
+    };
+    if fits(activation, &text)? {
+        return Ok(Some(text));
+    }
+    // the longest start of the text that fits with "..."
+    let ends: Vec<usize> = text.char_indices().map(|(i, _)| i).skip(1).chain([text.len()]).collect();
+    let (mut low, mut high) = (0, ends.len());
+    while low < high {
+        let middle = (low + high).div_ceil(2);
+        if fits(activation, &format!("{}...", text[..ends[middle - 1]].trim_end()))? {
+            low = middle;
+        } else {
+            high = middle - 1;
+        }
+    }
+    let shown = if low == 0 { "...".to_string() } else { format!("{}...", text[..ends[low - 1]].trim_end()) };
+    fits(activation, &shown)?;
+    Ok(Some(shown))
+}
+
+/// What a touch at (`x`, `y`) lands on, for gameswf's native buttons.
+enum Pick<'gc> {
+    Button(crate::display_object::DisplayObject<'gc>),
+    Other,
+}
+
+fn pick<'gc>(
+    context: &mut UpdateContext<'gc>,
+    object: crate::display_object::DisplayObject<'gc>,
+    point: swf::Point<swf::Twips>,
+    prefix: &str,
+) -> Option<Pick<'gc>> {
+    use crate::display_object::{HitTestOptions, TDisplayObject, TDisplayObjectContainer};
+    if !object.visible() || object.maskee().is_some() || object.clip_depth() > 0 {
+        return None;
+    }
+    let is_button = object.name().is_some_and(|n| n.to_string().starts_with(prefix));
+    if let Some(container) = object.as_container() {
+        let children: Vec<_> = container.iter_render_list().collect();
+        for child in children.into_iter().rev() {
+            match pick(context, child, point, prefix) {
+                Some(Pick::Other) if is_button => return Some(Pick::Button(object)),
+                Some(found) => return Some(found),
+                None => {}
+            }
+        }
+        None
+    } else if object.hit_test_shape(context, point, HitTestOptions::SKIP_INVISIBLE | HitTestOptions::SKIP_CHILDREN) {
+        Some(if is_button { Pick::Button(object) } else { Pick::Other })
+    } else {
+        None
+    }
+}
