+/// HTML with the attributes of its tags written strictly: no spaces around `=`, values in
+/// quotes (`<font size =26>` becomes `<font size="26">`), as gameswf read them; Supernova
+fn loose_html_attributes(html: &str) -> String {
+    let mut out = String::with_capacity(html.len() + 8);
+    let mut rest = html;
+    while let Some(start) = rest.find('<') {
+        out.push_str(&rest[..start]);
+        let Some(end) = rest[start..].find('>').map(|e| start + e) else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let tag = &rest[start + 1..end];
+        if !tag.contains('=') {
+            out.push_str(&rest[start..=end]);
+        } else {
+            out.push('<');
+            let chars: Vec<char> = tag.chars().collect();
+            let mut i = 0;
+            while i < chars.len() {
+                let c = chars[i];
+                if c == '=' {
+                    while out.ends_with(' ') {
+                        out.pop();
+                    }
+                    out.push('=');
+                    i += 1;
+                    while i < chars.len() && chars[i] == ' ' {
+                        i += 1;
+                    }
+                    if i < chars.len() && (chars[i] == '"' || chars[i] == '\'') {
+                        let quote = chars[i];
+                        out.push(quote);
+                        i += 1;
+                        while i < chars.len() && chars[i] != quote {
+                            out.push(chars[i]);
+                            i += 1;
+                        }
+                        out.push(quote);
+                        i += 1;
+                    } else {
+                        out.push('"');
+                        while i < chars.len() && chars[i] != ' ' && chars[i] != '/' {
+                            out.push(chars[i]);
+                            i += 1;
+                        }
+                        out.push('"');
+                    }
+                } else {
+                    out.push(c);
+                    i += 1;
+                }
+            }
+            out.push('>');
+        }
+        rest = &rest[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
