+/// Replace the pixels of the bitmap the root movie exports as `name` (gameswf's
+/// `ReplaceTexture`). `pixels(width, height)` gives RGBA pixels at the bitmap's size; shapes
+/// filled with the bitmap show the new pixels. Returns false without such a bitmap.
+pub fn replace_bitmap(
+    context: &mut UpdateContext<'_>,
+    name: &str,
+    pixels: impl FnOnce(u32, u32) -> Vec<u8>,
+) -> bool {
+    use crate::character::Character;
+    use crate::display_object::TDisplayObject;
+    use crate::string::WString;
+    use ruffle_render::bitmap::{Bitmap, BitmapFormat, PixelRegion};
+    let Some(root) = context.stage.root_clip() else {
+        return false;
+    };
+    let Some(library) = context.library.library_for_movie(root.movie()) else {
+        return false;
+    };
+    let Some((_, Character::Bitmap(bitmap))) = library.character_by_export_name(&WString::from_utf8(name)) else {
+        return false;
+    };
+    let size = bitmap.compressed().size();
+    let (width, height) = (size.width as u32, size.height as u32);
+    let Ok(handle) = bitmap.bitmap_handle(context.renderer) else {
+        return false;
+    };
+    let data = pixels(width, height);
+    let new = Bitmap::new(width, height, BitmapFormat::Rgba, data);
+    context
+        .renderer
+        .update_texture(&handle, new, PixelRegion::for_whole_size(width, height))
+        .is_ok()
+}
