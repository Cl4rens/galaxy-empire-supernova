 }
+
+/// Call `function` on the AVM1 object at `target` (a target path such as `_level2.panel`), like
+/// gameswf's `InvokeASCallback`. For players that drive a movie from outside (Supernova).
+pub fn call_avm1_function(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    function: &str,
+    args: Vec<Value>,
+) -> Value {
+    use crate::display_object::TDisplayObject;
+    use crate::string::WString;
+    let Some(base_clip) = context.stage.root_clip() else {
+        return Value::Null;
+    };
+    let mut activation = Avm1Activation::from_nothing(
+        context,
+        Avm1ActivationIdentifier::root("[InvokeASCallback]"),
+        base_clip,
+    );
+    let args: Vec<Avm1Value> = args.into_iter().map(|v| v.into_avm1(&mut activation)).collect();
+    let start = base_clip.object1_or_bare(activation.gc());
+    let path = WString::from_utf8(target);
+    let Ok(Some(object)) = activation.resolve_target_path(base_clip, start, &path, false, true) else {
+        tracing::warn!("InvokeASCallback: no object at {}", target);
+        return Value::Null;
+    };
+    let name = AvmString::new_utf8(activation.gc(), function);
+    match object.call_method(name, &args, &mut activation, crate::avm1::ExecutionReason::Special) {
+        Ok(value) => Value::from_avm1(&mut activation, value).unwrap_or(Value::Null),
+        Err(_) => Value::Null,
+    }
+}
