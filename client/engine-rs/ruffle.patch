+    /// Call `function` on the AVM1 object at `target`; see `external::call_avm1_function`.
+    pub fn call_avm1_function(
+        &mut self,
+        target: &str,
+        function: &str,
+        args: impl IntoIterator<Item = ExternalValue>,
+    ) -> ExternalValue {
+        let args: Vec<ExternalValue> = args.into_iter().collect();
+        self.mutate_with_update_context(|context| {
+            crate::external::call_avm1_function(context, target, function, args)
+        })
+    }
+
+    /// Set a property of the AVM1 object at `target`; see `external::set_avm1_property`.
+    pub fn set_avm1_property(&mut self, target: &str, name: &str, value: ExternalValue) -> bool {
+        self.mutate_with_update_context(|context| {
+            crate::external::set_avm1_property(context, target, name, value)
+        })
+    }
+
+    /// Draw the object at `target` in gray or normally; see `external::set_avm1_gray`.
+    pub fn set_avm1_gray(&mut self, target: &str, gray: bool) -> bool {
