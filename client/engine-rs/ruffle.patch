+/// Shrink the text of the text field at `target` until it fits its width, down to
+/// `min_scale` of `base_size` (gameswf's `SetLineMax(target, true, min_scale)`). Does nothing
+/// while the text is still `last_text`. Returns the base font size and the text it fitted.
+pub fn fit_avm1_text(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    min_scale: f64,
+    base_size: Option<f64>,
+    last_text: Option<&str>,
+) -> Option<(f64, String)> {
+    with_avm1_object(context, target, |activation, object| {
+        fit_text(activation, object, min_scale, base_size, last_text).ok().flatten()
+    })
+    .flatten()
+}
+
+fn fit_text<'gc>(
+    activation: &mut Avm1Activation<'_, 'gc>,
+    object: Avm1Object<'gc>,
+    min_scale: f64,
+    base_size: Option<f64>,
+    last_text: Option<&str>,
+) -> Result<Option<(f64, String)>, Avm1Error<'gc>> {
+    let text = object.get(AvmString::new_utf8(activation.gc(), "text"), activation)?;
+    let text = text.coerce_to_string(activation)?.to_string();
+    if last_text == Some(text.as_str()) {
+        return Ok(None);
+    }
+    let get_format = AvmString::new_utf8(activation.gc(), "getTextFormat");
+    let set_format = AvmString::new_utf8(activation.gc(), "setTextFormat");
+    let size_name = AvmString::new_utf8(activation.gc(), "size");
+    let reason = crate::avm1::ExecutionReason::Special;
+    let format = object.call_method(get_format, &[], activation, reason)?;
+    let Avm1Value::Object(format) = format else {
+        return Ok(None);
+    };
+    let base = match base_size {
+        Some(size) => size,
+        None => format.get(size_name, activation)?.coerce_to_f64(activation)?,
+    };
+    if !base.is_finite() || base <= 0.0 {
+        return Ok(None);
+    }
+    format.set(size_name, base, activation)?;
+    object.call_method(set_format, &[format.into()], activation, reason)?;
+    let width = object.get(AvmString::new_utf8(activation.gc(), "_width"), activation)?.coerce_to_f64(activation)?;
+    let text_width = object.get(AvmString::new_utf8(activation.gc(), "textWidth"), activation)?.coerce_to_f64(activation)?;
+    let room = width - 4.0;
+    if text_width > room && text_width > 0.0 {
+        let size = (base * (room / text_width).max(min_scale)).floor();
+        format.set(size_name, size, activation)?;
+        object.call_method(set_format, &[format.into()], activation, reason)?;
+    }
+    Ok(Some((base, text)))
+}
+
+/// Wrap the text of the text field at `target` at its width, and keep the lines centred on
+/// where the field is, as gameswf did with fields named `SLAC`. `place` is the field's own
+/// (y, height), from the first time; the text field's place is returned with its text. Does
+/// nothing while the text is still `last_text`.
+pub fn center_avm1_text(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    last_text: Option<&str>,
+    place: Option<(f64, f64)>,
+) -> Option<(String, (f64, f64))> {
+    with_avm1_object(context, target, |activation, object| {
+        center_text(activation, object, last_text, place).ok().flatten()
+    })
+    .flatten()
+}
+
+fn center_text<'gc>(
+    activation: &mut Avm1Activation<'_, 'gc>,
+    object: Avm1Object<'gc>,
+    last_text: Option<&str>,
+    place: Option<(f64, f64)>,
+) -> Result<Option<(String, (f64, f64))>, Avm1Error<'gc>> {
+    let text = object.get(AvmString::new_utf8(activation.gc(), "text"), activation)?;
+    let text = text.coerce_to_string(activation)?.to_string();
+    if last_text == Some(text.as_str()) {
+        return Ok(None);
+    }
+    let y_name = AvmString::new_utf8(activation.gc(), "_y");
+    let height_name = AvmString::new_utf8(activation.gc(), "_height");
+    let (y, height) = match place {
+        Some(place) => place,
+        None => (
+            object.get(y_name, activation)?.coerce_to_f64(activation)?,
+            object.get(height_name, activation)?.coerce_to_f64(activation)?,
+        ),
+    };
+    object.set(AvmString::new_utf8(activation.gc(), "multiline"), true, activation)?;
+    object.set(AvmString::new_utf8(activation.gc(), "wordWrap"), true, activation)?;
+    let center = AvmString::new_utf8(activation.gc(), "center");
+    object.set(AvmString::new_utf8(activation.gc(), "autoSize"), center, activation)?;
+    let new_height = object.get(height_name, activation)?.coerce_to_f64(activation)?;
+    object.set(y_name, y + (height - new_height) / 2.0, activation)?;
+    Ok(Some((text, (y, height))))
+}
+
+/// Cut the text of the text field at `target` where it leaves the field and end it with "...",
+/// as gameswf did with fields named single-line (`SLHM`: at the width, on one line) or
+/// multi-line (`MLHM`: at the height). Does nothing while the text is still `last_text`.
+/// Returns the text the field shows.
+pub fn truncate_avm1_text(
+    context: &mut UpdateContext<'_>,
+    target: &str,
+    multi_line: bool,
+    last_text: Option<&str>,
+) -> Option<String> {
+    with_avm1_object(context, target, |activation, object| {
+        truncate_text(activation, object, multi_line, last_text).ok().flatten()
+    })
+    .flatten()
+}
+
+fn truncate_text<'gc>(
+    activation: &mut Avm1Activation<'_, 'gc>,
+    object: Avm1Object<'gc>,
+    multi_line: bool,
+    last_text: Option<&str>,
+) -> Result<Option<String>, Avm1Error<'gc>> {
+    let text_name = AvmString::new_utf8(activation.gc(), "text");
+    let text = object.get(text_name, activation)?.coerce_to_string(activation)?.to_string();
+    if last_text == Some(text.as_str()) {
+        return Ok(None);
+    }
+    let (room_name, used_name) = if multi_line { ("_height", "textHeight") } else { ("_width", "textWidth") };
+    let room = object.get(AvmString::new_utf8(activation.gc(), room_name), activation)?.coerce_to_f64(activation)? - 4.0;
+    let used_name = AvmString::new_utf8(activation.gc(), used_name);
+    let fits = |activation: &mut Avm1Activation<'_, 'gc>, shown: &str| -> Result<bool, Avm1Error<'gc>> {
+        object.set(text_name, AvmString::new_utf8(activation.gc(), shown), activation)?;
+        Ok(object.get(used_name, activation)?.coerce_to_f64(activation)? <= room)
+    };
+    if fits(activation, &text)? {
+        return Ok(Some(text));
+    }
+    // the longest start of the text that fits with "..."
+    let ends: Vec<usize> = text.char_indices().map(|(i, _)| i).skip(1).chain([text.len()]).collect();
+    let (mut low, mut high) = (0, ends.len());
+    while low < high {
+        let middle = (low + high).div_ceil(2);
+        if fits(activation, &format!("{}...", text[..ends[middle - 1]].trim_end()))? {
+            low = middle;
+        } else {
+            high = middle - 1;
+        }
+    }
+    let shown = if low == 0 { "...".to_string() } else { format!("{}...", text[..ends[low - 1]].trim_end()) };
+    fits(activation, &shown)?;
+    Ok(Some(shown))
+}
+
+/// What a touch at (`x`, `y`) lands on, for gameswf's native buttons.
+enum Pick<'gc> {
+    Button(crate::display_object::DisplayObject<'gc>),
+    Other,
+}
+
+fn pick<'gc>(
+    context: &mut UpdateContext<'gc>,
+    object: crate::display_object::DisplayObject<'gc>,
+    point: swf::Point<swf::Twips>,
+    prefix: &str,
+    interactive: bool,
+) -> Option<Pick<'gc>> {
+    use crate::display_object::{HitTestOptions, TDisplayObject, TDisplayObjectContainer};
+    // text fields take no touches with gameswf (a wide "0/5" over a button)
+    if !object.visible() || object.maskee().is_some() || object.clip_depth() > 0 || object.as_edit_text().is_some() {
+        return None;
+    }
+    // clips named "btn..." are buttons, and so are "...btn" clips with a "released" frame
+    // (the chest screen's "helpbtn")
+    let is_button = object.name().is_some_and(|n| {
+        let n = n.to_string();
+        n.starts_with(prefix)
+            || (n.ends_with(prefix)
+                && object.as_movie_clip().is_some_and(|clip| {
+                    clip.frame_label_to_number(crate::string::WStr::from_units(b"released"), context).is_some()
+                }))
+    });
+    // only what reacts to the mouse covers what lies below it (a dialog's dark background with
+    // its onPress does, the end of a progress bar over a button does not)
+    let interactive = interactive
+        || is_button
+        || object.as_avm1_button().is_some()
+        || object.as_movie_clip().is_some_and(|clip| clip.is_button_mode(context));
+    if let Some(container) = object.as_container() {
+        let children: Vec<_> = container.iter_render_list().collect();
+        for child in children.into_iter().rev() {
+            match pick(context, child, point, prefix, interactive) {
+                Some(Pick::Other) if is_button => return Some(Pick::Button(object)),
+                Some(found) => return Some(found),
+                None => {}
+            }
+        }
+        None
+    } else if object.hit_test_shape(context, point, HitTestOptions::SKIP_INVISIBLE | HitTestOptions::SKIP_CHILDREN) {
+        if is_button {
+            Some(Pick::Button(object))
+        } else if interactive {
+            Some(Pick::Other)
+        } else {
+            None
+        }
+    } else {
+        None
+    }
+}
+
+/// The path of the topmost clip named `prefix...` (gameswf's native buttons are clips named
+/// "btn...") under the stage point (`x`, `y`), unless something above it covers the point.
+pub fn find_avm1_button(context: &mut UpdateContext<'_>, x: f64, y: f64, prefix: &str) -> Option<String> {
+    use crate::display_object::TDisplayObject;
+    let root = context.stage.root_clip()?;
+    match pick(context, root, swf::Point::from_pixels(x, y), prefix, false)? {
+        Pick::Button(button) => Some(button.path().to_string()),
+        Pick::Other => None,
+    }
+}
+
+/// Make AVM1 behave like gameswf where movies made for it count on it (see `avm1::GAMESWF`);
+/// for every player in the process.
+pub fn set_gameswf_compat(on: bool) {
+    crate::avm1::GAMESWF.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The paths of the text fields whose instance name contains `marker` (gameswf fitted the text
+/// of fields named "..._SLHM_..." into one line).
+pub fn text_field_paths(context: &mut UpdateContext<'_>, marker: &str) -> Vec<String> {
+    use crate::display_object::{DisplayObject, TDisplayObject, TDisplayObjectContainer};
+    fn walk(object: DisplayObject<'_>, marker: &str, out: &mut Vec<String>) {
+        if object.as_edit_text().is_some() && object.name().is_some_and(|n| n.to_string().contains(marker)) {
+            out.push(object.path().to_string());
+        }
+        if let Some(container) = object.as_container() {
+            for child in container.iter_render_list() {
+                walk(child, marker, out);
+            }
+        }
+    }
+    let mut out = Vec::new();
+    if let Some(root) = context.stage.root_clip() {
+        walk(root, marker, &mut out);
+    }
+    out
+}
+
+/// The property `name` of the AVM1 object at `target` (for looking into a running screen).
+pub fn get_avm1_property(context: &mut UpdateContext<'_>, target: &str, name: &str) -> Value {
+    with_avm1_object(context, target, |activation, object| {
+        let name = AvmString::new_utf8(activation.gc(), name);
+        match object.get(name, activation) {
+            Ok(value) => Value::from_avm1(activation, value).unwrap_or(Value::Null),
+            Err(_) => Value::Null,
+        }
+    })
+    .unwrap_or(Value::Null)
+}
