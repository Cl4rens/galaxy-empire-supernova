+/// `html` without the `align` attribute of its `<p>` tags; Supernova
+fn without_paragraph_align(html: &str) -> String {
+    let mut out = String::with_capacity(html.len());
+    let mut rest = html;
+    while let Some(start) = rest.find('<') {
+        out.push_str(&rest[..start]);
+        let Some(end) = rest[start..].find('>').map(|e| start + e + 1) else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let tag = &rest[start..end];
+        let lower = tag.to_ascii_lowercase();
+        if lower.starts_with("<p ") || lower.starts_with("<p\t") {
+            if let Some(at) = lower.find("align") {
+                // the attribute's value: quoted with ' or ", or up to the next space or '>'
+                let after = &tag[at + 5..];
+                let eq = after.find('=').filter(|e| after[..*e].trim().is_empty());
+                if let Some(eq) = eq {
+                    let value = after[eq + 1..].trim_start();
+                    let skipped = after.len() - value.len();
+                    let len = match value.chars().next() {
+                        Some(q @ ('\'' | '"')) => value[1..].find(q).map(|e| e + 2).unwrap_or(value.len()),
+                        _ => value.find(|c: char| c.is_whitespace() || c == '>').unwrap_or(value.len()),
+                    };
+                    out.push_str(&tag[..at]);
+                    out.push_str(&tag[at + 5 + skipped + len..]);
+                    rest = &rest[end..];
+                    continue;
+                }
+            }
+        }
+        out.push_str(tag);
+        rest = &rest[end..];
+    }
+    out.push_str(rest);
+    out
+}
